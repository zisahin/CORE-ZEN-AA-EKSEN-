# Do not modify this file -- YOUR CHANGES WILL BE ERASED!
#
# This file should *NOT* be checked into Version Control Systems,
# as it contains information specific to your local configuration.
#
# Location of the SDK. This is only used by Gradle.
# For customization when using a Version Control System, please read the
# header note.
sdk.dir=/path/to/your/android/sdk

# API Keys - Bu dosya git'e commit edilmez
# YouTube API Key'inizi buraya ekleyin
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Mapbox Access Token'ınızı buraya ekleyin
# https://account.mapbox.com/ adresinden alabilirsiniz
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN_HERE

# Firebase API Key (google-services.json'dan alınacak)
# Firebase Console'dan indirdiğiniz google-services.json dosyasındaki api_key değeri
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
